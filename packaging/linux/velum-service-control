#!/bin/bash
set -Eeuo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
[[ $# -gt 0 ]] || { printf 'Usage: velum-service-control {install|start|stop|restart|status|uninstall}\n' >&2; exit 2; }
case $1 in
  install|start|stop|restart|status|uninstall)
    exec /usr/bin/python3 -I /usr/local/lib/velum/linux_service_installer.py "$@"
    ;;
  *) printf 'Unknown Velum service action.\n' >&2; exit 2 ;;
esac
